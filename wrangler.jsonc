{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudbrowser",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "vars": {
    "BROWSER_SESSION_TTL_SECONDS": "600",
    "MAX_CONCURRENT_SESSIONS": "3"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BROWSER_SESSIONS",
        "class_name": "BrowserSession"
      },
      {
        "name": "BROWSER_CONTAINERS",
        "class_name": "BrowserContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BrowserSession"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["BrowserContainer"]
    }
  ],
  // Full desktop sessions. Chromium needs real memory: standard-1 is the
  // smallest instance that runs it comfortably. Remove this block (and the
  // BrowserContainer binding above) to deploy without container support.
  "containers": [
    {
      "class_name": "BrowserContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 3
    }
  ],
  // Local `wrangler dev` would otherwise require a running Docker daemon just
  // to boot. Pass --enable-containers when you actually want to exercise a
  // container session locally.
  "dev": {
    "enable_containers": false
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/screen/*"]
  },
  "observability": {
    "enabled": true
  }
}
