{
  "name": "cloudbrowser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=/tmp/cloudbrowser-wrangler.log wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && WRANGLER_LOG_PATH=/tmp/cloudbrowser-wrangler.log wrangler deploy --dry-run --outdir .wrangler/dry-run --containers-rollout=none",
    "deploy": "WRANGLER_LOG_PATH=/tmp/cloudbrowser-wrangler.log wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "@cloudflare/workers-types": "^5.20260724.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  }
}
